#!/system/bin/sh
DIR=${0%/*}
. "$DIR/../settings.ini"
umask 077
mkdir -p "$tailscaled_run_dir" || exit 1
chmod 0700 "$tailscaled_run_dir"

is_daemon() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$(readlink "/proc/$1/exe" 2>/dev/null)" = "$tailscaled_bin" ] && kill -0 "$1" 2>/dev/null
}

find_daemon() {
  PID=$(cat "$tailscaled_pid" 2>/dev/null)
  is_daemon "$PID" && return 0
  for proc in /proc/[0-9]*/exe; do
    [ "$(readlink "$proc" 2>/dev/null)" = "$tailscaled_bin" ] || continue
    PID=${proc#/proc/}
    PID=${PID%/exe}
    is_daemon "$PID" && return 0
  done
  PID=
  return 1
}

ready() {
  [ -S "$tailscaled_run_dir/tailscaled.sock" ] &&
    TS_BE_CLI=1 timeout 3 "$tailscale_bin" $tailscale_bin_param status --json >/dev/null 2>&1
}

describe() {
  [ -f "$module_prop" ] || return 0
  sed -i "s/^description=\(\[.*\][[:space:]]*\)*/description=[ $1 ] /" "$module_prop"
}

lock_service() {
  lock="$tailscaled_run_dir/service.lock"
  if ! mkdir "$lock" 2>/dev/null; then
    owner=$(cat "$lock/pid" 2>/dev/null)
    case "$owner" in
      ''|*[!0-9]*) echo 'Service operation already in progress' >&2; return 1 ;;
    esac
    if kill -0 "$owner" 2>/dev/null; then
      echo 'Service operation already in progress' >&2
      return 1
    fi
    rm -f "$lock/pid"
    rmdir "$lock" 2>/dev/null && mkdir "$lock" 2>/dev/null || return 1
  fi
  echo $$ > "$lock/pid"
  trap 'rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null' EXIT
  trap 'exit 1' HUP INT TERM
}

start_tailscaled() {
  if find_daemon; then
    if ready; then
      echo "$PID" > "$tailscaled_pid"
      echo "tailscaled ready (PID $PID)"
      return 0
    fi
    echo "tailscaled PID $PID is not ready; inspect $tailscaled_log or restart" >&2
    return 1
  fi
  rm -f "$tailscaled_pid" "$tailscaled_run_dir/tailscaled.sock"
  setup_home || return 1
  (unset TS_BE_CLI; exec nohup "$tailscaled_bin" $tailscaled_bin_param) > "$tailscaled_log" 2>&1 < /dev/null &
  PID=$!
  echo "$PID" > "$tailscaled_pid"
  attempts=0
  while [ "$attempts" -lt 30 ]; do
    if ! kill -0 "$PID" 2>/dev/null; then
      rm -f "$tailscaled_pid"
      describe 'tailscaled failed'
      echo "tailscaled exited during startup; see $tailscaled_log" >&2
      tail -n 15 "$tailscaled_log" >&2
      return 1
    fi
    if ready; then
      describe 'tailscaled running'
      log Info "tailscaled ready (PID $PID)"
      echo "tailscaled ready (PID $PID)"
      return 0
    fi
    sleep 1
    attempts=$((attempts + 1))
  done
  echo "tailscaled startup timed out; see $tailscaled_log" >&2
  stop_tailscaled
  return 1
}

stop_tailscaled() {
  if find_daemon; then
    kill -TERM "$PID" || return 1
    attempts=0
    while is_daemon "$PID" && [ "$attempts" -lt 20 ]; do
      sleep 1
      attempts=$((attempts + 1))
    done
    if is_daemon "$PID"; then
      echo "tailscaled PID $PID did not stop; preserving PID file" >&2
      return 1
    fi
  fi
  rm -f "$tailscaled_pid" "$tailscaled_run_dir/tailscaled.sock"
  describe 'tailscaled stopped'
  log Info 'tailscaled stopped'
  echo 'tailscaled stopped'
}

case "$1" in
  start|stop|restart)
    lock_service || exit 1
    case "$1" in
      start) start_tailscaled ;;
      stop) stop_tailscaled ;;
      restart) stop_tailscaled && start_tailscaled ;;
    esac
    ;;
  status)
    if find_daemon && ready; then
      echo "tailscaled ready (PID $PID)"
    else
      echo 'tailscaled stopped or not ready'
      exit 1
    fi
    ;;
  log)
    case "$2" in
      runs) cat "$tailscaled_runs_log" ;;
      service) cat "$tailscaled_service_log" ;;
      tailscaled|'') tail -n 100 -f "$tailscaled_log" ;;
      *) echo 'usage: tailscaled.service log {runs|service|tailscaled}' >&2; exit 2 ;;
    esac
    ;;
  *) echo 'usage: tailscaled.service {start|stop|restart|status|log}' >&2; exit 2 ;;
esac
